ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:8000"]

DATABASE__URL=postgresql+asyncpg://servia:servia@localhost:5433/servia

# Only for docker-compose.yml on the server. There the app reaches the databases by
# service name: DATABASE__URL=postgresql+asyncpg://servia:<password>@postgres:5432/servia
# and CACHE__URL=redis://redis:6379/0
# POSTGRES_USER=servia
# POSTGRES_PASSWORD=
# POSTGRES_DB=servia

LIVEKIT__URL=wss://your-project.livekit.cloud
LIVEKIT__API_KEY=
LIVEKIT__API_SECRET=
LIVEKIT__AGENT_NAME=servia

SPEECH__STT_MODEL=deepgram/nova-3
SPEECH__LLM_MODEL=google/gemma-4-31b-it
SPEECH__TTS_MODEL=inworld/inworld-tts-2
SPEECH__TTS_VOICE=Ashley

# Set to a call id to test the agent in `console` mode, where LiveKit sends no metadata.
# DEV_CALL_ID=
# Warm agent processes; raise in production.
# LIVEKIT__IDLE_PROCESSES=1
